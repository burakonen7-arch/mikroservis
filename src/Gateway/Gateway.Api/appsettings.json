{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "Jwt": { "Issuer": "mikroservis", "Audience": "mikroservis-api" },
  "RateLimiting": { "PermitLimit": 60, "WindowSeconds": 60, "LoginPermitLimit": 5 },
  "ReverseProxy": {
    "Routes": {
      "products": { "ClusterId": "product", "Match": { "Path": "/products/{**remainder}" } },
      "stocks": { "ClusterId": "stock", "Match": { "Path": "/stocks/{**remainder}" } }
    },
    "Clusters": {
      "product": { "Destinations": { "api": { "Address": "http://localhost:5001/" } } },
      "stock": { "Destinations": { "api": { "Address": "http://localhost:5002/" } } }
    }
  }
}
