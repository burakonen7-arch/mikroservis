<Project>
  <Target Name="ValidateCleanArchitecture" BeforeTargets="ResolveProjectReferences">
    <PropertyGroup>
      <IsDomainProject>$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('.Domain'))</IsDomainProject>
      <IsApplicationProject>$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('.Application'))</IsApplicationProject>
    </PropertyGroup>
    <ItemGroup>
      <ExternalFrameworkReference Include="@(FrameworkReference)"
        Condition="'%(FrameworkReference.Identity)' != 'Microsoft.NETCore.App'" />
    </ItemGroup>

    <ItemGroup Condition="'$(MSBuildProjectName)' == 'Product.Application'">
      <InvalidCoreReference Include="@(ProjectReference)"
        Condition="'%(ProjectReference.Filename)' != 'Product.Domain' And '%(ProjectReference.Filename)' != 'Shared.Application'" />
    </ItemGroup>
    <ItemGroup Condition="'$(MSBuildProjectName)' == 'Stock.Application'">
      <InvalidCoreReference Include="@(ProjectReference)"
        Condition="'%(ProjectReference.Filename)' != 'Stock.Domain' And '%(ProjectReference.Filename)' != 'Shared.Application'" />
    </ItemGroup>
    <ItemGroup Condition="'$(MSBuildProjectName)' == 'User.Application'">
      <InvalidCoreReference Include="@(ProjectReference)"
        Condition="'%(ProjectReference.Filename)' != 'User.Domain'" />
    </ItemGroup>
    <ItemGroup Condition="'$(IsApplicationProject)' == 'True'">
      <InvalidApplicationPackage Include="@(PackageReference)"
        Condition="'%(PackageReference.Identity)' != 'MediatR' Or ('$(MSBuildProjectName)' != 'Product.Application' And '$(MSBuildProjectName)' != 'Stock.Application')" />
    </ItemGroup>

    <Error Condition="'$(IsDomainProject)' == 'True' And ('@(ProjectReference)' != '' Or '@(PackageReference)' != '' Or '@(ExternalFrameworkReference)' != '')"
      Text="Domain projects must remain independent of other projects and external frameworks." />
    <Error Condition="'@(InvalidCoreReference)' != ''"
      Text="Application projects may reference only permitted inner layers: @(InvalidCoreReference)." />
    <Error Condition="'$(IsApplicationProject)' == 'True' And ('@(InvalidApplicationPackage)' != '' Or '@(ExternalFrameworkReference)' != '')"
      Text="Only Product.Application and Stock.Application may use MediatR; other Application projects must not reference external packages or frameworks." />
    <Error Condition="'$(MSBuildProjectName)' == 'Shared.Application' And '@(ProjectReference)' != ''"
      Text="Shared.Application must not reference service or infrastructure projects." />
    <Error Condition="'$(MSBuildProjectName)' == 'Contracts' And ('@(ProjectReference)' != '' Or '@(PackageReference)' != '' Or '@(ExternalFrameworkReference)' != '')"
      Text="Contracts must contain only framework independent integration messages." />
  </Target>
</Project>
